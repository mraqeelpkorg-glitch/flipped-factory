# Flipped Factory — Environment Config
# Copy to .env and fill in values

# ─── Instagram (for auto-posting) ─────────────────────────────────────────────
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ─── AI Script (Ollama runs locally for FREE) ────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Factory Settings ─────────────────────────────────────────────────────────
VIDEOS_PER_DAY=3
DASHBOARD_PORT=8003

# ─── TTS Settings ─────────────────────────────────────────────────────────────
TTS_RATE=150
TTS_VOLUME=0.9
